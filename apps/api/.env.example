# Copie para apps/api/.env e ajuste. Valores fictícios — nunca commite o .env.
# Validado por src/config/env.schema.ts: a API não sobe com variável faltando ou inválida.

# development | test | production
NODE_ENV=development
# local | development | homologacao | producao (distingue homologação de produção, ambas com NODE_ENV=production).
# Padrão local; com NODE_ENV=production é obrigatória e só aceita homologacao ou producao.
APP_ENV=local
# Porta HTTP (padrão 3000)
PORT=3000
# Postgres local do docker-compose (pnpm db:up)
DATABASE_URL=postgresql://atletica:atletica@localhost:5432/atletica_dev
# Só para o Prisma CLI (não é lida pela API): banco sombra vazio usado por
# `prisma migrate diff --from-migrations` (prisma.config.ts). Opcional no dia a dia.
# SHADOW_DATABASE_URL=postgresql://atletica:atletica@localhost:5432/atletica_shadow
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- E-mail transacional (#61) ---
# resend | fake | log — log (desenvolvimento) só escreve no console; resend é obrigatório com NODE_ENV=production.
EMAIL_PROVIDER=log
# Chave da API do Resend; obrigatória com EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Remetente; o domínio precisa estar verificado no Resend (SPF/DKIM).
EMAIL_REMETENTE="Atlética <nao-responda@exemplo.com.br>"
# Segredo do HMAC dos códigos de verificação (≥ 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CODIGO_PEPPER=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais

# --- Autenticação (#7) ---
# Segredo HS256 do access token (≥ 32 caracteres), distinto em cada ambiente. Trocar o valor
# invalida todos os access tokens (o refresh recupera). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais

# --- Imagens no Cloudflare R2 (#54) ---
# Obrigatórias. Valores fictícios bastam para subir a API localmente (o presign gera URLs que não
# funcionam); os reais, com token restrito ao bucket do ambiente, são configurados na #92.
# Account ID da Cloudflare (32 caracteres hexadecimais).
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=troque-pela-chave-do-token-r2
R2_SECRET_ACCESS_KEY=troque-pelo-segredo-do-token-r2
R2_BUCKET_IMAGENS=atletica-imagens-hml
# URL pública do bucket (https, sem barra final); as respostas expõem `fotoUrl` = <base>/<fotoKey>.
R2_PUBLIC_BASE_URL=https://imagens.exemplo.com.br

# --- Sentry (#48) ---
# DSN do projeto atletica-api; vazio = Sentry desligado (local e testes). DSNs reais: #93.
SENTRY_DSN=
# Fração de requisições com trace (0 a 1): 0.1 em produção, 1.0 em homologação. Padrão 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Fila (#86) ---
# false desliga workers e crons do pg-boss (só enfileira). Padrão true.
FILA_WORKERS_ATIVOS=true

# --- Push (#87) ---
# Token do Expo Push Service; obrigatória com APP_ENV=producao. Nos testes o envio usa o FakeExpoPush.
EXPO_ACCESS_TOKEN=

# --- Seed (#45) — lidas só por `pnpm --filter api prisma:seed`; a API sobe sem elas ---
# Administrador inicial, criado só se a Lorde ainda não tiver um (a senha de um admin existente nunca muda).
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_NOME="Administrador"
# Política do UC06: 8 a 128 caracteres, ao menos uma letra e um número.
SEED_ADMIN_SENHA=
# true grava dados de demonstração (senha conhecida); recusado com APP_ENV=producao.
SEED_DEMO=false
