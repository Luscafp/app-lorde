    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.5",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
