# Env dos testes da API. Valores fictícios — este arquivo é versionado.
# Lido por test/setup/env.ts: um `apps/api/.env.test` (fora do Git) sobrescreve estes valores e as
# variáveis já definidas no ambiente (CI) sobrescrevem os dois. NODE_ENV é sempre `test`.

# Postgres de testes do docker-compose (pnpm db:up): porta 5433, dados em tmpfs.
# O nome do banco precisa terminar em `_test` — o globalSetup recusa qualquer outro.
DATABASE_URL=postgresql://atletica:atletica@localhost:5433/atletica_test
LOG_LEVEL=silent
EMAIL_PROVIDER=fake
EMAIL_REMETENTE="Atlética Teste <nao-responda@teste.local>"
CODIGO_PEPPER=pepper-de-teste-com-pelo-menos-32-caracteres
JWT_ACCESS_SECRET=segredo-jwt-de-teste-com-pelo-menos-32-caracteres
