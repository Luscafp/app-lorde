# Copie para apps/mobile/.env. Variáveis EXPO_PUBLIC_ são embutidas no bundle: nunca coloque segredos aqui.

# URL base da API (com /api/v1). No aparelho físico use o IP da máquina na rede local, não localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api/v1
# development | homologacao | producao (convenções §11.11)
EXPO_PUBLIC_AMBIENTE=development
